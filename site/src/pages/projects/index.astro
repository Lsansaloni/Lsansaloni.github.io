---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Projects — LluckyGames" wide>
  <h1>Projects</h1>
  <p class="muted">
    Small, complete, playable. Each one exists to answer a design question.
  </p>

  <div class="card-grid">
    <a class="card" href={`${base}/projects/rock-paper-magic/`}>
      <p class="card-kicker">Playable prototype</p>
      <h3>Rock Paper Magic</h3>
      <p>
        Five-way rock-paper-scissors: five moves, first to three rounds, and
        an AI whose patterns you're supposed to learn. Tiny on purpose.
      </p>
      <p style="margin-top: 0.8rem"><span class="pill in-progress">In progress</span></p>
    </a>
    <div class="card" style="opacity: 0.6">
      <p class="card-kicker">Next</p>
      <h3>Slot two</h3>
      <p>
        Probably an economy sandbox — a tiny idle game with a currency faucet
        and sink you can actually break.
      </p>
      <p style="margin-top: 0.8rem"><span class="pill planned">Planned</span></p>
    </div>
  </div>
</Layout>
