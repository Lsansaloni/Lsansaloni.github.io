---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Layout title="Writing — LluckyGames">
  <h1>Writing</h1>
  <p class="muted">
    Live-service economies, dissected with numbers — and what I'd design
    differently.
  </p>

  <ul class="article-list">
    {
      articles.map((article) => (
        <li>
          <span class="date">{fmt(article.data.pubDate)}</span>
          <h3>
            <a href={`${base}/writing/${article.id}/`}>{article.data.title}</a>
          </h3>
          <p>{article.data.description}</p>
          {article.data.tags.length > 0 && (
            <div class="tag-row">
              {article.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ul>

  {
    articles.length === 0 && (
      <p class="muted">First essay on its way — League of Legends' RP economy.</p>
    )
  }
</Layout>
