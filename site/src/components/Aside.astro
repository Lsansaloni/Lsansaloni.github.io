---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside
  style="border:1px solid var(--border-strong);border-left:3px solid var(--accent);border-radius:8px;padding:1rem 1.2rem;margin:1.5rem 0;background:var(--bg-raised)"
>
  {title && <p style="font-family:var(--font-heading);font-weight:500;margin-top:0">{title}</p>}
  <div style="color:var(--text-muted);font-size:0.92rem">
    <slot />
  </div>
</aside>
